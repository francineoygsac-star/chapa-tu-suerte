# JSON.pe Bearer token. Set this in your hosting provider (Render, Railway, etc.), not in GitHub.
JSONPE_TOKEN=pega_aqui_tu_token_de_json_pe

# Existing application secrets
FLASK_SECRET=cambia_esta_clave
ADMIN_USER=admin
ADMIN_PASSWORD=cambia_esta_clave
COOKIE_SECURE=1

# Google Cloud Storage (las credenciales se montan como Secret File en Render)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-cloud-key.json
GCS_BUCKET_NAME=chapa-tu-suerte-comprobantes

# Firestore usa la base predeterminada (default) del mismo proyecto.
